# 心屿 auth-service 本地开发环境变量
# 复制此文件为 .env 并填入实际值；服务器上请放到 /etc/auth-service.env

PORT=3002
JWT_SECRET=please-change-this-secret-to-a-long-random-string

# 管理员后台账号（登录 /back 管理后台用）
ADMIN_USER=admin
ADMIN_PASS=admin123

# SMTP 邮件发送配置（用 QQ/163/Gmail 邮箱的 SMTP 授权码）
# 以 QQ 邮箱为例：
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的QQ号@qq.com
SMTP_PASS=你的QQ邮箱SMTP授权码
SMTP_FROM=心屿 <你的QQ号@qq.com>
